"""The free-module surface used by uconf, including Sage category methods.

Sage reassigns Element in __init__, so source inference treats it as a
variable rather than a base class. Keep the class alias explicit here.
"""

from collections.abc import Iterable, Mapping
from typing import Any

from sage.modules.module import Module
from sage.modules.with_basis.indexed_element import IndexedFreeModuleElement
from sage.structure.indexed_generators import IndexedGenerators
from sage.structure.unique_representation import UniqueRepresentation

class CombinatorialFreeModule(UniqueRepresentation, Module, IndexedGenerators):
    Element = IndexedFreeModuleElement
    element_class: type[IndexedFreeModuleElement]
    def __init__(self, R: Any, basis_keys: Any = None, **kwds: Any) -> None: ...
    def __call__(self, x: Any = 0, *args: Any, **kwds: Any) -> Any: ...
    def base_ring(self) -> Any: ...
    def basis(self) -> Any: ...
    def category(self) -> Any: ...
    def dimension(self) -> Any: ...
    def term(self, index: Any, coeff: Any = None) -> Any: ...
    def monomial(self, index: Any) -> Any: ...
    def sum_of_terms(self, terms: Iterable[tuple[Any, Any]], distinct: bool = False) -> Any: ...
    def sum(self, iter_of_elements: Iterable[Any]) -> Any: ...
    def linear_combination(
        self, iter_of_elements_coeff: Iterable[tuple[Any, Any]], factor_on_left: bool = True
    ) -> Any: ...
    def zero(self) -> Any: ...
    def _from_dict(
        self, d: Mapping[Any, Any], coerce: bool = False, remove_zeros: bool = True
    ) -> Any: ...
    def _element_constructor_(self, x: Any) -> Any: ...
    def module_morphism(self, *args: Any, **kwds: Any) -> Any: ...
    def tensor(self, *others: Any, **kwds: Any) -> Any: ...
    def rename(self, x: str | None = None) -> None: ...
    def _repr_term(self, basis_key: Any, /) -> str: ...
    def _latex_term(self, basis_key: Any, /) -> str: ...
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...

class CombinatorialFreeModule_Tensor(CombinatorialFreeModule): ...
class CombinatorialFreeModule_CartesianProduct(CombinatorialFreeModule): ...
