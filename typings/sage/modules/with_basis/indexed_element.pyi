"""The sparse-element API used by uconf, including inherited operations.

Flatten the Cython ModuleElement base here: inheriting an unresolved base
would make arbitrary attributes and unrelated types acceptable again.
"""

from collections.abc import Iterator
from typing import Any, Self

class IndexedFreeModuleElement:
    _monomial_coefficients: dict[Any, Any]
    def __init__(self, M: Any, x: dict[Any, Any]) -> None: ...
    def parent(self) -> Any: ...
    def base_ring(self) -> Any: ...
    def __iter__(self) -> Iterator[tuple[Any, Any]]: ...
    def __bool__(self) -> bool: ...
    def __contains__(self, x: Any) -> bool: ...
    def __getitem__(self, m: Any) -> Any: ...
    def __hash__(self) -> int: ...
    def __add__(self, other: Any) -> Self: ...
    def __radd__(self, other: Any) -> Self: ...
    def __sub__(self, other: Any) -> Self: ...
    def __rsub__(self, other: Any) -> Self: ...
    def __neg__(self) -> Self: ...
    def __mul__(self, other: Any) -> Self: ...
    def __rmul__(self, other: Any) -> Self: ...
    def __truediv__(self, other: Any) -> Self: ...
    def _add_(self, other: Self) -> Self: ...
    def _sub_(self, other: Self) -> Self: ...
    def _neg_(self) -> Self: ...
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...
    def monomial_coefficients(self, copy: bool = True) -> dict[Any, Any]: ...
    def support(self) -> list[Any]: ...
    def coefficient(self, m: Any) -> Any: ...
    def is_zero(self) -> bool: ...
    def tensor(self, *others: Any) -> Any: ...
    def leading_support(self, *args: Any, **kwds: Any) -> Any: ...
    def degree(self) -> Any: ...
